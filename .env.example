# ─────────────────────────────────────────────
# IEEJAY EATS API — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# Prisma / PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ieejay_eats?schema=public"

# ─── Rate limiting ────────────────────────────
# Max requests allowed per window per IP
RATE_LIMIT_MAX=100
# Window duration in milliseconds (60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# ─── Pagination ───────────────────────────────
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# ─── Node environment ─────────────────────────
NODE_ENV=development
